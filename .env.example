# Copy to .env for local testing. In GitHub Actions these are repo secrets.

# --- Preferred: Horizons HTTP ingest API ---
# Site origin (no /hcgi/platform path required; we strip it if present)
HORIZONS_BASE_URL=https://YOUR_APP_ID.app-preview.com
# Sent as header X-Ingest-Key
INGEST_API_KEY=your_ingest_api_key_here

# Optional: full PocketBase URL — origin is derived for API calls
# DATABASE_URL=https://YOUR_APP_ID.app-preview.com/hcgi/platform

# --- Legacy: direct PocketBase superuser (only if INGEST_API_KEY unset) ---
# POCKETBASE_ADMIN_EMAIL=your-admin@email.com
# POCKETBASE_ADMIN_PASSWORD=your-admin-password

# Free key: https://api.congress.gov/sign-up/
CONGRESS_GOV_API_KEY=your_congress_gov_api_key_here
